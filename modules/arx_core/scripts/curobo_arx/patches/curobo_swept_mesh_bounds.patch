+@wp.func
+def swept_bounds_overlap(
+    obs: MeshDataWarp, env_idx: int, obs_idx: int, current: wp.vec3,
+    previous: wp.vec3, following: wp.vec3, radius: float,
+) -> bool:
+    """Reject only when both entire neighbor segments miss the expanded mesh AABB."""
+    if obs.use_swept_bounds == 0:
+        return True
+    idx = env_idx * obs.max_n + obs_idx
+    # Outward padding absorbs float32 transform/interpolation roundoff. It only
+    # retains extra narrow-phase queries; collision margins remain unchanged.
+    padding = wp.max(radius, 0.0) + 0.00001
+    for axis in range(3):
+        lower = wp.min(current[axis], wp.min(previous[axis], following[axis]))
+        upper = wp.max(current[axis], wp.max(previous[axis], following[axis]))
+        roundoff = 0.000001 * wp.max(wp.abs(lower), wp.abs(upper))
+        if upper < obs.bounds_lower[idx, axis] - padding - roundoff:
+            return False
+        if lower > obs.bounds_upper[idx, axis] + padding + roundoff:
+            return False
+    return True
