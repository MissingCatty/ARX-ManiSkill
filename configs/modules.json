{
  "schema_version": 1,
  "modules": {
    "sam3": {
      "source": "modules/sam3",
      "role": "segmentation",
      "environment": "environments/sam3",
      "adapter": "modules/sam3/arx_adapter.py",
      "weights": [
        "weights/sam3/sam3.pt"
      ],
      "inputs": [
        "camera/color.png",
        "camera/depth.png",
        "camera/params.json",
        "entry.json"
      ],
      "outputs": [
        "camera/mask.png",
        "camera/depth_m.npy",
        "sam3.json"
      ]
    },
    "rayst3r": {
      "source": "modules/rayst3r",
      "role": "reconstruction",
      "environment": "environments/reconstruction",
      "adapter": "modules/rayst3r/memory_efficient/adapter.py",
      "weights": [
        "weights/rayst3r/rayst3r.pth",
        "weights/dinov2/dinov2_vitl14_reg4_pretrain.pth"
      ],
      "inputs": [
        "camera/color.png",
        "camera/mask.png",
        "camera/depth_m.npy",
        "state.json"
      ],
      "outputs": [
        "completed_points_camera.npy",
        "completed_points_world.npy",
        "rayst3r.json"
      ],
      "reconstruction": "modules/rayst3r/memory_efficient/adapter.py",
      "source_directories": [
        "modules/rayst3r/memory_efficient"
      ],
      "startup_free_mib": 23000,
      "compute_validation_report": "configs/experiments/history/rayst3r_memory_validation_20261125.json",
      "compute_activation_receipt": "configs/experiments/history/rayst3r_memory_activation_20261125.json",
      "source_files": [
        "configs/experiments/history/rayst3r_memory_validation_20261125.json",
        "configs/experiments/history/rayst3r_memory_activation_20261125.json",
        "configs/experiments/history/rayst3r_workspace_validation_20261125.json",
        "configs/experiments/history/rayst3r_loader_alignment_20261125.json"
      ],
      "workspace_reservation_mib": 14336,
      "workspace_validation_report": "configs/experiments/history/rayst3r_workspace_validation_20261125.json"
    },
    "graspgenx": {
      "source": "modules/graspgenx",
      "role": "grasp_generation",
      "environment": "environments/graspgenx",
      "adapter": "modules/graspgenx/arx_adapter.py",
      "weights": [
        "weights/graspgenx/gen",
        "weights/graspgenx/dis"
      ],
      "inputs": [
        "completed_points_world.npy"
      ],
      "outputs": [
        "graspgenx_raw/grasps_generator_world.npy",
        "graspgenx_raw/scores.npy",
        "graspgenx_raw/inference.json"
      ]
    },
    "curobo": {
      "source": "modules/curobo",
      "role": "motion_planning",
      "environment": "environments/curobo",
      "adapter": "modules/curobo/arx_adapter.py",
      "inputs": [
        "state.json",
        "candidates/candidate_pool.json"
      ],
      "outputs": [
        "plan_result.json"
      ],
      "asset_resources": [
        "curobo_assets"
      ],
      "policies": [
        "configs/policies/fingertip_table.json"
      ]
    },
    "maniskill": {
      "source": "modules/maniskill",
      "role": "simulation",
      "environment": "environments/simulation",
      "asset_resources": [
        "maniskill_package_assets"
      ]
    },
    "pipeline": {
      "source": "modules/pipeline",
      "role": "experiment_orchestration",
      "environment": "environments/simulation"
    },
    "camera": {
      "source": "modules/camera",
      "role": "camera_geometry",
      "environment": "environments/simulation"
    },
    "arx_core": {
      "source": "modules/arx_core",
      "role": "robot_configuration_and_shared_control"
    },
    "zerograsp": {
      "source": "modules/zerograsp",
      "role": "baseline_perception",
      "environment": "environments/graspcl",
      "weights": [
        "weights/zerograsp/mainline/zerograsp_synthetic.ckpt"
      ],
      "reconstruction": "modules/zerograsp/arx_reconstruction.py",
      "asset_resources": [
        "zerograsp_arx_assets"
      ]
    },
    "graspcl": {
      "source": "modules/graspcl",
      "role": "grasp_ranking",
      "environment": "environments/graspcl",
      "weights": [
        "weights/graspcl"
      ]
    },
    "dinov2": {
      "source": "modules/dinov2",
      "role": "visual_features",
      "environment": "environments/reconstruction",
      "weights": [
        "weights/dinov2"
      ]
    },
    "claro": {
      "source": "modules/claro",
      "role": "occlusion_orchestration",
      "environment": "environments/sam3"
    },
    "reachability": {
      "source": "modules/reachability",
      "role": "kinematic_analysis",
      "environment": "environments/curobo"
    },
    "curobo_adapter": {
      "source": "modules/curobo_adapter",
      "role": "version_comparison",
      "environment": "environments/curobo_v090",
      "asset_resources": [
        "curobo_v090_assets"
      ]
    },
    "curobo_dual_arm": {
      "source": "modules/curobo/dual_arm",
      "role": "motion_planning",
      "environment": "environments/curobo",
      "adapter": "modules/curobo/dual_arm/adapter.py",
      "inputs": [
        "state.json",
        "candidates/candidate_pool.json"
      ],
      "outputs": [
        "plan_result.json",
        "arms/right/plan_result.json",
        "arms/left/plan_result.json"
      ],
      "policies": [
        "configs/policies/fingertip_table.json",
        "configs/experiments/sam3_graspgenx_v3.json"
      ],
      "source_files": [
        "arx_project/artifacts.py",
        "arx_project/candidate_rpc.py",
        "arx_project/json_io.py",
        "modules/curobo/candidate_io/store.py"
      ],
      "candidate_data_delivery": "one request decode; shared arm views; optional shared-memory handoff",
      "candidate_transport_format": "arx_candidate_json_shm_v1"
    },
    "curobo_dual_arm_map": {
      "source": "modules/curobo/dual_arm",
      "role": "motion_planning",
      "environment": "environments/curobo",
      "adapter": "modules/curobo/dual_arm/interleaved_map_service.py",
      "inputs": [
        "state.json",
        "candidates/candidate_pool.json"
      ],
      "optional_inputs": [
        "placement_witness.json"
      ],
      "outputs": [
        "plan_result.json",
        "endpoint_gate.json"
      ],
      "policies": [
        "configs/policies/fingertip_table.json",
        "configs/experiments/dual_arm_interleaving.json"
      ],
      "source_files": [
        "arx_project/artifacts.py",
        "arx_project/candidate_rpc.py",
        "arx_project/json_io.py",
        "modules/curobo/candidate_io/store.py",
        "modules/curobo/dual_arm/interleaved_map_service.py",
        "modules/curobo/dual_arm/interleaved_adapter.py",
        "modules/curobo/dual_arm/adapter.py"
      ],
      "candidate_data_delivery": "one request decode; shared arm views; optional shared-memory handoff",
      "candidate_transport_format": "arx_candidate_json_shm_v1",
      "variant": "alternating_candidate_windows"
    },
    "mobile_manipulation": {
      "source": "modules/mobile_manipulation",
      "role": "base_and_lift_placement",
      "environment": "environments/simulation",
      "inputs": [
        "state.json",
        "camera/mask.png",
        "camera/depth_m.npy",
        "candidates/candidate_pool.json"
      ],
      "outputs": [
        "stationing/selected.json",
        "stationing/command.json",
        "stationing/receipt.json"
      ]
    },
    "curobo_indexed_planning": {
      "source": "modules/curobo/indexed_planning",
      "role": "motion_planning",
      "environment": "environments/curobo",
      "adapter": "modules/curobo/indexed_planning/service.py",
      "inputs": [
        "state.json",
        "candidates/candidate_pool.json"
      ],
      "outputs": [
        "plan_result.json",
        "interleaved_search.json"
      ],
      "policies": [
        "configs/experiments/indexed_grasp_native_batch.json",
        "configs/policies/fingertip_table.json"
      ],
      "experimental": true,
      "default_enabled": false,
      "variant": "native_endpoint_batches_with_original_contact_gates"
    },
    "graspgenx_postprocessing": {
      "source": "modules/graspgenx/postprocessing",
      "role": "candidate_postprocessing_library",
      "environment": "environments/geometric_ik",
      "entrypoint": "modules/graspgenx/postprocessing/filters.py",
      "experimental": true,
      "default_enabled": false,
      "inputs": [
        "state.json",
        "camera/depth_m.npy",
        "camera/mask.png",
        "completed_points_world.npy",
        "candidates/candidate_pool.json"
      ],
      "outputs": [
        "candidate_indices_and_NMS_groups",
        "geometry_masks"
      ],
      "weights": []
    },
    "curobo_analytic_endpoints": {
      "source": "modules/curobo/analytic_ik",
      "role": "motion_planning",
      "environment": "environments/curobo",
      "adapter": "modules/curobo/analytic_ik/runtime.py",
      "experimental": true,
      "default_enabled": false,
      "inputs": [
        "state.json",
        "candidates/candidate_pool.json"
      ],
      "outputs": [
        "plan_result.json",
        "analytic_endpoint_windows/*.json"
      ],
      "policies": [
        "configs/experiments/analytic_endpoint_planning.json",
        "configs/policies/fingertip_table.json"
      ],
      "variant": "fixed256_analytic_branches_with_original_width_V2_and_path_fallback"
    }
  }
}
